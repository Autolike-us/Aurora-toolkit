{
  "manifest_version": 3,
  "name": "Aurora Reply — comment replies in your voice",
  "version": "1.0.0",
  "description": "Drafts replies to comments in your own voice. You read, edit and send every reply yourself.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Aurora Reply",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://getaurorastudios.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "content/adapters.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://getaurorastudios.com/reply/"
}
